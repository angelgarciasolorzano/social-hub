# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
#
# These settings define the application environment used while running tests.
# The application key is generated automatically by `composer setup`.
#
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
#
# The test suite uses the same MySQL engine as the local application. The
# database is created automatically by `composer setup`.
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social-hub-testing
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------------------
# Test Runtime
# --------------------------------------------------------------------------
#
# These values keep the test suite fast and deterministic by reducing the
# computational cost of password hashing and disabling frontend SSR.
#
BCRYPT_ROUNDS=4
INERTIA_SSR_ENABLED=false

# --------------------------------------------------------------------------
# Test Services
# --------------------------------------------------------------------------
#
# Array and synchronous drivers keep test data in memory and process jobs,
# mail, sessions, and cache operations without external services.
#
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# --------------------------------------------------------------------------
# Optional Services
# --------------------------------------------------------------------------
#
# These services are disabled during tests to avoid collecting telemetry or
# writing additional monitoring data while the suite is running.
#
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
