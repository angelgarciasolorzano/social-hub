# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
#
# These settings define the application name, environment, debug behavior, and
# base URL used by the local installation.
#
APP_NAME="Social Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --------------------------------------------------------------------------
# Localization
# --------------------------------------------------------------------------
#
# Set the default language, fallback language, and locale used by Faker.
#
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --------------------------------------------------------------------------
# Maintenance
# --------------------------------------------------------------------------
#
# Choose how the application stores its maintenance mode state.
#
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# --------------------------------------------------------------------------
# Local Development Server
# --------------------------------------------------------------------------
#
# Configure the number of workers used by PHP's built-in development server.
#
PHP_CLI_SERVER_WORKERS=4

# --------------------------------------------------------------------------
# Password Hashing
# --------------------------------------------------------------------------
#
# Set the bcrypt work factor used when hashing passwords.
#
BCRYPT_ROUNDS=12

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
#
# Select the log channels and severity threshold used by the application.
#
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
#
# Configure the database connection used by the application.
#
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --------------------------------------------------------------------------
# Sessions
# --------------------------------------------------------------------------
#
# Choose the session storage driver, lifetime, and cookie behavior.
#
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --------------------------------------------------------------------------
# Broadcast, Filesystem, and Queue
# --------------------------------------------------------------------------
#
# Configure event broadcasting, file storage, and queued job processing.
#
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --------------------------------------------------------------------------
# Cache
# --------------------------------------------------------------------------
#
# Select the default cache store and optionally set a custom key prefix.
#
CACHE_STORE=database
# CACHE_PREFIX=

# --------------------------------------------------------------------------
# Memcached
# --------------------------------------------------------------------------
#
# Configure the Memcached server address when using that cache store.
#
MEMCACHED_HOST=127.0.0.1

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
#
# Configure the Redis client, connection, credentials, and port.
#
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------
#
# Configure the mail transport and the sender identity used by outgoing mail.
#
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@socialhub.example"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# AWS
# --------------------------------------------------------------------------
#
# Credentials and connection shared by the s3, media and backups disks. With a
# local S3 emulator such as LocalStack or MiniStack use
# AWS_ENDPOINT=http://localhost:4566 and AWS_USE_PATH_STYLE_ENDPOINT=true.
# AWS_BUCKET and AWS_URL only belong to the general s3 disk, which the
# application does not use today. Keep this block above the media and backup
# blocks: they reuse these values through ${...}.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET=
AWS_URL=

# --------------------------------------------------------------------------
# Media
# --------------------------------------------------------------------------
#
# MediaLibrary stores profile pictures, covers and post images on MEDIA_DISK
# (public by default). Set it to `media` to keep them in their own S3 bucket.
# MEDIA_S3_URL must be reachable from the browser, e.g.
# http://localhost:4566/<bucket> on a local emulator. The credentials and the
# connection reuse the AWS values above; replace them only if the images live
# on another provider or account.
#
MEDIA_DISK=public
MEDIA_S3_BUCKET=
MEDIA_S3_URL=
MEDIA_S3_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
MEDIA_S3_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"
MEDIA_S3_DEFAULT_REGION="${AWS_DEFAULT_REGION}"
MEDIA_S3_ENDPOINT="${AWS_ENDPOINT}"
MEDIA_S3_USE_PATH_STYLE_ENDPOINT="${AWS_USE_PATH_STYLE_ENDPOINT}"

# --------------------------------------------------------------------------
# Database Backups
# --------------------------------------------------------------------------
#
# Encrypted database archives go to their own private bucket. The credentials
# and the connection reuse the AWS values above; in production replace the
# key and secret with a dedicated IAM identity limited to this bucket. Store
# the archive passphrase in your deployment secrets.
#
BACKUP_S3_BUCKET=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_S3_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
BACKUP_S3_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"
BACKUP_S3_DEFAULT_REGION="${AWS_DEFAULT_REGION}"
BACKUP_S3_ENDPOINT="${AWS_ENDPOINT}"
BACKUP_S3_USE_PATH_STYLE_ENDPOINT="${AWS_USE_PATH_STYLE_ENDPOINT}"

# --------------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------------
#
# Values prefixed with VITE_ are exposed to the frontend build.
#
VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Reverb
# --------------------------------------------------------------------------
#
# Configure the Reverb WebSocket server used by `composer run dev`. The id,
# key, and secret below are local development placeholders: change them if
# the server is ever exposed beyond your machine. To broadcast through Reverb,
# also set BROADCAST_CONNECTION=reverb.
#
REVERB_APP_ID=social-hub-local
REVERB_APP_KEY=social-hub-local-key
REVERB_APP_SECRET=social-hub-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --------------------------------------------------------------------------
# Social Hub
# --------------------------------------------------------------------------
#
# Configure trusted-device cookie duration and automatic purge retention.
#
SOCIALHUB_AUTH_TRUSTED_DEVICE_COOKIE_LIFETIME_MINUTES=43200
SOCIALHUB_AUTH_TRUSTED_DEVICE_PURGE_AFTER_DAYS=90

#
# Configure how many days each activity log keeps its records before the
# daily activity-log:purge deletes them.
#
SOCIALHUB_ACTIVITY_LOG_AUTH_RETENTION_DAYS=180
SOCIALHUB_ACTIVITY_LOG_CONTENT_RETENTION_DAYS=365
SOCIALHUB_ACTIVITY_LOG_LIKES_RETENTION_DAYS=30
SOCIALHUB_ACTIVITY_LOG_TRUSTED_DEVICES_RETENTION_DAYS=180
SOCIALHUB_ACTIVITY_LOG_ACCOUNT_RETENTION_DAYS=365
SOCIALHUB_ACTIVITY_LOG_ADMIN_RETENTION_DAYS=730
