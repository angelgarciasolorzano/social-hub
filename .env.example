# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
#
# These settings define the application name, environment, debug behavior, and
# base URL used by the local installation.
#
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --------------------------------------------------------------------------
# Localization
# --------------------------------------------------------------------------
#
# Set the default language, fallback language, and locale used by Faker.
#
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --------------------------------------------------------------------------
# Maintenance
# --------------------------------------------------------------------------
#
# Choose how the application stores its maintenance mode state.
#
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# --------------------------------------------------------------------------
# Local Development Server
# --------------------------------------------------------------------------
#
# Configure the number of workers used by PHP's built-in development server.
#
PHP_CLI_SERVER_WORKERS=4

# --------------------------------------------------------------------------
# Password Hashing
# --------------------------------------------------------------------------
#
# Set the bcrypt work factor used when hashing passwords.
#
BCRYPT_ROUNDS=12

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
#
# Select the log channels and severity threshold used by the application.
#
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
#
# Configure the database connection used by the application.
#
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --------------------------------------------------------------------------
# Sessions
# --------------------------------------------------------------------------
#
# Choose the session storage driver, lifetime, and cookie behavior.
#
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --------------------------------------------------------------------------
# Broadcast, Filesystem, and Queue
# --------------------------------------------------------------------------
#
# Configure event broadcasting, file storage, and queued job processing.
#
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --------------------------------------------------------------------------
# Cache
# --------------------------------------------------------------------------
#
# Select the default cache store and optionally set a custom key prefix.
#
CACHE_STORE=database
# CACHE_PREFIX=

# --------------------------------------------------------------------------
# Memcached
# --------------------------------------------------------------------------
#
# Configure the Memcached server address when using that cache store.
#
MEMCACHED_HOST=127.0.0.1

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
#
# Configure the Redis client, connection, credentials, and port.
#
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------
#
# Configure the mail transport and the sender identity used by outgoing mail.
#
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# AWS
# --------------------------------------------------------------------------
#
# Provide AWS credentials and storage settings when using AWS services.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------------
#
# Values prefixed with VITE_ are exposed to the frontend build.
#
VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Reverb
# --------------------------------------------------------------------------
#
# Configure the Reverb WebSocket server used by `composer run dev`. The id,
# key, and secret below are local development placeholders: change them if
# the server is ever exposed beyond your machine. To broadcast through Reverb,
# also set BROADCAST_CONNECTION=reverb.
#
REVERB_APP_ID=social-hub-local
REVERB_APP_KEY=social-hub-local-key
REVERB_APP_SECRET=social-hub-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --------------------------------------------------------------------------
# Social Hub
# --------------------------------------------------------------------------
#
# Configure trusted-device cookie duration and automatic purge retention.
#
SOCIALHUB_AUTH_TRUSTED_DEVICE_COOKIE_LIFETIME_MINUTES=
SOCIALHUB_AUTH_TRUSTED_DEVICE_PURGE_AFTER_DAYS=
