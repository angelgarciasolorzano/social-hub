# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
#
# These settings configure the application for automated CI checks.
#
APP_NAME=SocialHub
APP_ENV=ci
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
#
# Backend database checks connect to their local MySQL service with these values.
# Other CI jobs may copy this file without connecting to the database.
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social-hub-ci
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------------------
# Runtime Services
# --------------------------------------------------------------------------
#
# In-memory and synchronous drivers avoid external services in CI.
#
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------
#
# Keep test and CI mail delivery in memory.
#
MAIL_MAILER=array

# --------------------------------------------------------------------------
# Broadcast and Filesystem
# --------------------------------------------------------------------------
#
# Log broadcast events and use local file storage during CI.
#
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
#
# Send CI logs to standard error and report only errors.
#
LOG_CHANNEL=stderr
LOG_LEVEL=error
